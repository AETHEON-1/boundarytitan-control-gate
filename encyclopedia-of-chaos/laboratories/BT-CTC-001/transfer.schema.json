{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "authority_state",
    "source",
    "target",
    "proposition",
    "dimensions",
    "counterevidence",
    "reopen",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "authority_state": {
      "const": "CANDIDATE"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "url",
        "custody"
      ],
      "properties": {
        "record": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "custody": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "proposition": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "correspondence",
          "limitation",
          "defeating_observation",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "correspondence": {
            "type": "string",
            "minLength": 1
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          },
          "defeating_observation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "counterevidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reopen": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "string",
      "minLength": 1
    }
  }
}
