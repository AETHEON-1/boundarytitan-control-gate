{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundarytitan.example/schemas/consequence-receipt.schema.json",
  "title": "ConsequenceReceipt",
  "type": "object",
  "required": [
    "receipt_id",
    "schema_version",
    "created_at",
    "lane",
    "proposed_action",
    "named_accountable_owner",
    "evidence",
    "affected_surface",
    "expected_consequence",
    "reversibility",
    "external_stop_path",
    "approval_state",
    "who_can_still_say_no",
    "routing_color"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "proposed_action": {
      "type": "string",
      "minLength": 1
    },
    "action_scope": {
      "type": "string"
    },
    "named_accountable_owner": {
      "type": "string",
      "minLength": 1
    },
    "decision_owner": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "affected_surface": {
      "type": "string",
      "minLength": 1
    },
    "expected_consequence": {
      "type": "string",
      "minLength": 1
    },
    "reversibility": {
      "enum": [
        "REVERSIBLE",
        "PARTIALLY_REVERSIBLE",
        "IRREVERSIBLE",
        "UNKNOWN"
      ]
    },
    "rollback_plan": {
      "type": "string"
    },
    "external_stop_path": {
      "type": "string",
      "minLength": 1
    },
    "stop_path_owner": {
      "type": "string"
    },
    "stop_path_test_status": {
      "enum": [
        "UNTESTED",
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "approval_state": {
      "enum": [
        "PENDING",
        "APPROVED",
        "DENIED",
        "EXPIRED",
        "REVOKED",
        "SUPERSEDED"
      ]
    },
    "permission_state": {
      "enum": [
        "NOT_GRANTED",
        "GRANTED",
        "SUSPENDED",
        "EXPIRED",
        "REVOKED",
        "CONSUMED"
      ]
    },
    "release_state": {
      "enum": [
        "NOT_RELEASED",
        "RELEASED",
        "BLOCKED",
        "EXPIRED",
        "REVOKED",
        "CONSUMED"
      ]
    },
    "execution_state": {
      "enum": [
        "NOT_STARTED",
        "STARTED",
        "PAUSED",
        "STOPPED",
        "SUCCEEDED",
        "FAILED",
        "ROLLED_BACK",
        "IRREVERSIBLE"
      ]
    },
    "expiry": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revocation_authority": {
      "type": "string"
    },
    "who_can_still_say_no": {
      "type": "string",
      "minLength": 1
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routing_color": {
      "enum": [
        "GREEN_ELIGIBLE",
        "YELLOW",
        "RED",
        "BLACK"
      ]
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "additionalProperties": false
}
