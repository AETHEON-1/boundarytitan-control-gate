{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundarytitan.example/schemas/operational-guidance.schema.json",
  "title": "BoundaryTitan Operational Guidance Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "source_ref",
    "commit_sha",
    "consulted_paths",
    "source_classes",
    "evidence_state",
    "authorization_state",
    "gate_state"
  ],
  "properties": {
    "repository": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "consulted_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "constitutional_doctrine",
          "operational_doctrine",
          "domain_translation",
          "case_evidence",
          "visual_rhetorical_compression",
          "proposed_implementation_control"
        ]
      }
    },
    "detected_conflicts": {
      "type": "array",
      "default": [],
      "items": {"type": "string"}
    },
    "evidence_state": {
      "enum": ["sufficient", "incomplete", "contradicted", "unknown"]
    },
    "authorization_state": {
      "enum": ["externally_established", "absent", "conflicted", "unknown"]
    },
    "consequence_owner": {
      "type": ["string", "null"]
    },
    "external_stop_path": {
      "type": ["string", "null"]
    },
    "who_can_still_say_no": {
      "type": ["string", "null"]
    },
    "gate_state": {
      "enum": ["GREEN", "YELLOW", "RED", "BLACK"]
    },
    "decision_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "rule", "effect"],
        "properties": {
          "path": {"type": "string"},
          "rule": {"type": "string"},
          "effect": {"enum": ["allow_preparation", "hold", "refuse", "route_to_owner"]}
        }
      }
    },
    "record_is_permission": {
      "const": false
    }
  }
}
